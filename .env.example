# ==========================================
# VELORA CRM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

STORAGE_TYPE=local

# ------------------------------------------
# BREVO EMAIL SERVICE CONFIGURATION
# ------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_email@example.com

# ------------------------------------------
# RABBITMQ QUEUE SERVICE CONFIGURATION
# ------------------------------------------
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>

# ------------------------------------------
# REDIS CACHE & RATE LIMITING CONFIGURATION
# ------------------------------------------
REDIS_URL=rediss://default:<password>@<endpoint>:6379

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/companycrm?appName=Cluster0

AUTH_MONGO_URI=
CONTACT_MONGO_URI=
OPPORTUNITY_MONGO_URI=
TASK_MONGO_URI=
NOTIFICATION_MONGO_URI=
ANALYTICS_MONGO_URI=
DOCUMENT_MONGO_URI=
PRODUCT_MONGO_URI=
INVOICE_MONGO_URI=
TICKET_MONGO_URI=
SEARCH_MONGO_URI=
HR_MONGO_URI=

JWT_SECRET=your_jwt_secret_key_here

# Initial Production Admin Credentials (Used on first boot auto-provisioning)
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
