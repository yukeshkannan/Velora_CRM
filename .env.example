# ==========================================
# VELORA CRM - PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# Port Configuration
PORT=5000
VITE_API_URL=http://<YOUR_SERVER_IP>:5000

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
# Main MongoDB Connection String (e.g. MongoDB Atlas or self-hosted MongoDB on OCI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/companycrm?retryWrites=true&w=majority

# Optional per-service MongoDB URIs (leave blank to inherit MONGO_URI with dynamic db isolation)
AUTH_MONGO_URI=
CONTACT_MONGO_URI=
OPPORTUNITY_MONGO_URI=
TASK_MONGO_URI=
NOTIFICATION_MONGO_URI=
ANALYTICS_MONGO_URI=
DOCUMENT_MONGO_URI=
PRODUCT_MONGO_URI=
INVOICE_MONGO_URI=
TICKET_MONGO_URI=
SEARCH_MONGO_URI=
HR_MONGO_URI=

# ------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------
# Generate a secure 64-char random key via: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret_minimum_32_characters

# Initial Admin Account Auto-Provisioning (created only if no Admin exists)
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=SetAStrongPasswordHere!123

# ------------------------------------------
# MESSAGE BROKER & CACHING
# ------------------------------------------
# Default connects to local Docker Compose containers if not specified
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672

# ------------------------------------------
# EMAIL NOTIFICATIONS (BREVO / SMTP)
# ------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=no-reply@yourcompany.com

# Optional SMTP fallback (if not using Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ------------------------------------------
# FILE STORAGE CONFIGURATION
# ------------------------------------------
STORAGE_TYPE=local

# AWS / S3 Compatible Object Storage (Optional, for AWS S3 or Oracle Cloud Object Storage S3-compatible API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-ashburn-1
AWS_BUCKET_NAME=
