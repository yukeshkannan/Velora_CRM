FROM node:20-alpine
WORKDIR /app

# Copy workspace package manifests and source
COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY apps/ ./apps/

# Single monorepo dependency installation shared across all microservices
RUN npm install --no-audit

EXPOSE 5000 5001 5002 5003 5004 5005 5006 5007 5008 5009 5010 5011 5012
CMD ["npm", "start"]
